# 复制为 deploy/.env（仅保存在服务器，勿提交），并替换全部 CHANGE_ME
PROJECT_NAME=FSFT MES
# 浏览器访问地址（CORS），如 http://1.2.3.4 或 https://mes.example.com
FRONTEND_HOST=http://CHANGE_ME
HTTP_PORT=80

# openssl rand -hex 32
SECRET_KEY=CHANGE_ME
POSTGRES_DB=app
# postgres 超级用户（迁移用）
POSTGRES_PASSWORD=CHANGE_ME
# 应用运行角色 app_user（RLS 生效）
APP_DB_PASSWORD=CHANGE_ME

FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=CHANGE_ME

# Q-Time 后台扫描间隔（秒，0 关闭）
QTIME_SWEEP_SECONDS=60
# 首次部署导入 MES 演示数据（1 导入，0 不导入；重复执行幂等性见文档）
SEED_DEMO=0

# 国内镜像源
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
NPM_REGISTRY=https://registry.npmmirror.com
