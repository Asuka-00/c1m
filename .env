# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Full Stack FastAPI Project"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=admin123

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
# App connects as a NON-owner role so Postgres RLS is enforced
DATABASE_URL=postgresql://app_user:app_user_pw_change_me@localhost:5432/app
# Owner / admin role for migrations and DB role setup
MIGRATION_DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
